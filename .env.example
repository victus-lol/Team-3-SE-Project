FLASK_ENV=development
FLASK_APP=server/run.py
SECRET_KEY=change-this-in-production-use-a-strong-random-key
DATABASE_URL=sqlite:///instance/task_manager.sqlite
APP_TIMEZONE=UTC
SQLALCHEMY_ECHO=0
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PUBLIC_APP_URL=http://localhost:5173

# Required to deliver account recovery links. Use SMTP submission with STARTTLS,
# or set MAIL_USE_SSL=true for an SSL SMTP endpoint (commonly port 465).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_SSL=false

